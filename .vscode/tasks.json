{
    "version": "2.0.0",
    "tasks": [
{
  "label": "build multicut with clang in MSVC env",
  "type": "shell",
  "command": "cmd.exe",
  "args": [
    "/c",
    "\"C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\VC\\Auxiliary\\Build\\vcvars64.bat\" && \"C:\\Program Files\\LLVM\\bin\\clang++.exe\" -std=c++17 -O3 -g -o \"${workspaceFolder}\\code\\multicut.exe\" \"${workspaceFolder}\\code\\Image.cpp\" \"${workspaceFolder}\\code\\Util.cpp\" \"${workspaceFolder}\\code\\main.cpp\" \"${workspaceFolder}\\code\\huffman.cpp\" \"${workspaceFolder}\\code\\compress.cpp\" \"${workspaceFolder}\\code\\mc.cpp\" \"${workspaceFolder}\\code\\decompress.cpp\" -I\"${workspaceFolder}\\zlib\\include\" -L\"${workspaceFolder}\\zlib\" -lzdll -fcolor-diagnostics -fansi-escape-codes"
  ],
  "problemMatcher": ["$gcc"],
  "group": {
    "kind": "build",
    "isDefault": true
  }
},
        {
            "label": "build multicut",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-O3",
                "-g",
                "-o",
                "${workspaceFolder}/code/multicut",
                "${workspaceFolder}/code/Image.cpp",
                "${workspaceFolder}/code/Util.cpp",
                "${workspaceFolder}/code/main.cpp",
                "${workspaceFolder}/code/huffman.cpp",
                "${workspaceFolder}/code/compress.cpp",
                "${workspaceFolder}/code/mc.cpp",
                "${workspaceFolder}/code/decompress.cpp",

                "${workspaceFolder}/build/adler32.o",
                "${workspaceFolder}/build/compress.o",
                "${workspaceFolder}/build/crc32.o",
                "${workspaceFolder}/build/deflate.o",
                "${workspaceFolder}/build/trees.o",
                "${workspaceFolder}/build/zutil.o",
                "${workspaceFolder}/build/inflate.o",
                "${workspaceFolder}/build/infback.o",
                "${workspaceFolder}/build/inftrees.o",
                "${workspaceFolder}/build/inffast.o",
                "${workspaceFolder}/build/uncompr.o",


                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "`pkg-config",
                "--cflags",
                "--libs",
                "opencv4`"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build zlib via script",
            "type": "shell",
            "command": "${workspaceFolder}/build_zlib.sh",
            "group": "build",
            "problemMatcher": []
        },        
        {
            "label": "build multicut - no optimization",
            "type": "shell",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-O0",
                "-g",
                "-o",
                "${workspaceFolder}/code/multicut",
                "${workspaceFolder}/code/Image.cpp",
                "${workspaceFolder}/code/Util.cpp",
                "${workspaceFolder}/code/main.cpp",
                "${workspaceFolder}/code/huffman.cpp",
                "${workspaceFolder}/code/compress.cpp",
                "${workspaceFolder}/code/mc.cpp",
                "${workspaceFolder}/code/decompress.cpp",
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "`pkg-config",
                "--cflags",
                "--libs",
                "opencv4`"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}